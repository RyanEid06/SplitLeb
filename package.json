{
  "name": "splitleb",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:pwa": "node scripts/qa-pwa.mjs",
    "format": "prettier --write src scripts vite.config.ts index.html public/manifest.webmanifest",
    "qa:prepare-v1": "node scripts/prepare-v1-qa.mjs",
    "qa:unsaved": "node scripts/qa-unsaved.mjs",
    "qa:legacy-tabs": "node scripts/qa-legacy-tabs.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.5.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
